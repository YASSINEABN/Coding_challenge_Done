{
    "name": "abandoned-cart/reminder-system",
    "description": "Abandoned cart reminder system with email notifications",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "predis/predis": "^2.2",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "AbandonedCart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AbandonedCart\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
